{
  "name": "vibe-cdn",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "A Cloudflare game stack for heavy browser games: R2 assets, Worker CDN, Durable Object rooms, D1 scores, KV saves.",
  "scripts": {
    "demo": "bun scripts/demo.ts",
    "dev": "bun scripts/demo.ts --no-open",
    "dev:worker": "wrangler dev --local --persist-to .wrangler/state --port 4783",
    "dev:app": "vite --host 127.0.0.1 --port 5374",
    "seed": "bun scripts/seed-local.ts",
    "smoke": "bun scripts/smoke.ts",
    "optimize": "bun scripts/optimize.ts",
    "check": "tsc --noEmit",
    "build": "vite build && wrangler deploy --dry-run --outdir dist/worker",
    "deploy": "vite build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply vibe-cdn-db --local --persist-to .wrangler/state",
    "test": "bun test"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.2.1",
    "@gltf-transform/extensions": "^4.2.1",
    "@gltf-transform/functions": "^4.2.1",
    "agents": "^0.17.4",
    "three": "^0.181.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@cloudflare/workers-types": "^4.20260525.0",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.3",
    "wrangler": "^4.82.1",
    "ws": "^8.18.3"
  }
}
